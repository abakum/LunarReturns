{
  "name": "lunarreturns-bot",
  "version": "1.0.0",
  "description": "VK-бот лунно-солнечных юбилеев LunarReturns",
  "main": "lunarreturns.js",
  "bin": {
    "ged2txt": "bin/ged2txt.cjs",
    "txt2ged": "bin/txt2ged.cjs",
    "trim": "bin/trim.cjs"
  },
  "scripts": {
    "build:viewer": "node dev/build-viewer.mjs",
    "test:viewer": "node dev/viewer-check.mjs && node dev/viewer-repl-check.mjs",
    "start": "node lunarreturns.js",
    "deploy": "tgcloud push"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "topola": "3.11.1"
  }
}
