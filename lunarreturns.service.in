# Шаблон системного юнита: значения подставляет lunarreturns-install.sh,
# который кладёт готовый юнит в /etc/systemd/system/lunarreturns.service.
#
# Сервис изолирован от пользователя-установщика:
#   - DynamicUser — одноразовый системный пользователь без логина;
#   - StateDirectory — свой каталог /var/lib/lunarreturns (там db.json, LR_DB);
#   - конфиг с токеном: /etc/lunarreturns/.env (VK_TOKEN=…), root:root 600;
#   - каталог репо используется только на чтение (lunarreturns.js).

[Unit]
Description=LunarReturns VK jubilee bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=lunarreturns
Environment=LR_DB=/var/lib/lunarreturns/db.json
EnvironmentFile=@CFG@/.env
ExecStart=@NODE@ @DIR@/lunarreturns.js
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
